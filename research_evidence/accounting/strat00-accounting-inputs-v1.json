{
 "conventions": {
  "R": "net / (|entry_fill - stop| x qty)",
  "entry": "market at the open of the entry bar; slip-v1 bps from the 15 closed 4h bars available at that open; buy for long, sell for short; no tick / step rounding (tick = None, qty unrounded)",
  "exit_time": "time exit and gap stop: the exit bar open; non-gap stop: the stop bar close (open + 4h)",
  "fees": "taker 0.05% x |fill x qty| on entry and on exit",
  "funding": "costs.funding_cost base row: sum over events entry <= T < exit_time of sign x rate x qty x mark (sign +1 long, -1 short; + = paid); mark = funding-mark proxy v1 (close of the 1h mark bar ending at or before T)",
  "gross": "long: (exit - entry) x qty; short: (entry - exit) x qty",
  "net": "gross - fees - funding",
  "qty": "qty = 1000.0 / entry_fill",
  "slip_bps": "max(2, c x 1e4 x TR-SMA14 / last close), c = slip-cal-v1 crypto 0.05; TR_i = max(h-l, |h-c_prev|, |l-c_prev|) over the last 14 of the 15 bars",
  "stop": "long: entry_fill x (1 - stop_pct); short: entry_fill x (1 + stop_pct). Checked on every bar from the entry bar on: long hit when low <= stop, short when high >= stop. costs.stop_reference: a bar that opens through the stop fills at its open (gap = true, gap slip multiplier), else at the stop; slip-v1 bps from the 15 closed bars available at that bar open; sell for long, buy for short",
  "time_exit": "no stop within max_bars bars (entry bar included): market at the open of bar entry + max_bars, slip-v1 bps from the 15 closed bars available at that open"
 },
 "costs": {
  "gap_slip_mult": 1.0,
  "notional": 1000.0,
  "slip_bars": 15,
  "slip_c": 0.05,
  "slip_floor_bps": 2.0,
  "taker": 0.0005
 },
