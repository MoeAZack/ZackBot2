{
 "format": "zb-newcore-tnet-scenario/1",
 "name": "t08_cancel_replace_race_short",
 "description": "TNET-01 T08 cancel/replace race (fill wins, FakeVenue only): after TP1 the break-even replacement (classic refused -> algo) is in flight when the price falls through the OLD stop, which fills the rest; the replacement is confirmed after that, the cancel of the old stop is refused (already filled), the old stop fill is booked and the replacement is released.",
 "symbols": [
  "SOLUSDT"
 ],
 "account": {
  "min_balance": "100",
  "adopt_foreign": []
 },
 "steps": [
  {
   "id": "entry",
   "op": "market",
   "symbol": "SOLUSDT",
   "side": "SHORT",
   "reduce": false,
   "qty": "5"
  },
  {
   "id": "protect",
   "op": "stop",
   "symbol": "SOLUSDT",
   "side": "SHORT",
   "qty": "filled:entry",
   "trigger_offset_pct": "2",
   "from": "entry",
   "route": "classic"
  },
  {
   "id": "protect_algo",
   "op": "stop",
   "symbol": "SOLUSDT",
   "side": "SHORT",
   "qty": "filled:entry",
   "trigger_offset_pct": "2",
   "from": "entry",
   "route": "algo"
  },
  {
   "id": "tp1",
   "op": "market",
   "symbol": "SOLUSDT",
   "side": "SHORT",
   "reduce": true,
   "qty": "2.5"
  },
  {
   "id": "breakeven_classic",
   "op": "stop",
   "symbol": "SOLUSDT",
   "side": "SHORT",
   "qty": "2.5",
   "trigger_offset_pct": "-0.1",
   "from": "entry",
   "route": "classic"
  },
  {
   "id": "breakeven",
   "op": "stop",
   "symbol": "SOLUSDT",
   "side": "SHORT",
   "qty": "2.5",
   "trigger_offset_pct": "-0.1",
   "from": "entry",
   "route": "algo"
  },
  {
   "id": "unstop_old",
   "op": "cancel",
   "ref": "protect_algo"
  },
  {
   "id": "unstop_new",
   "op": "cancel",
   "ref": "breakeven"
  },
  {
   "id": "settle",
   "op": "wait",
   "seconds": 2
  }
 ],
 "expect": {
  "outcomes": {
   "entry": [
    "final"
   ],
   "protect": [
    "rejected"
   ],
   "protect_algo": [
    "known"
   ],
   "tp1": [
    "final"
   ],
   "breakeven_classic": [
    "rejected"
   ],
   "breakeven": [
    "known"
   ],
   "unstop_old": [
    "rejected"
   ],
   "unstop_new": [
    "final"
   ]
  },
  "end_state": {
