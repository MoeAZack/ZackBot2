{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zackbot.local/contracts/signal-intent-v1.schema.json",
  "title": "ZackBot Signal Intent v1",
  "description": "Strict external or internal signal envelope. Authentication, account environment and automation authority are server-side configuration and cannot be selected by this payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "signal_id",
    "source",
    "account",
    "action",
    "symbol",
    "strategy_id",
    "strategy_version",
    "generated_at_ms",
    "expires_at_ms",
    "dry_run"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "signal_id": {"type": "string", "pattern": "^sig_[0-9a-f]{32}$"},
    "trade_family_id": {"type": ["string", "null"], "pattern": "^fam_[0-9a-f]{32}$"},
    "source": {"enum": ["internal_strategy", "tradingview", "manual"]},
    "account": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"},
    "action": {"enum": ["enter", "reduce", "close", "modify"]},
    "symbol": {"type": "string", "pattern": "^[A-Z0-9]{2,30}$"},
    "side": {"enum": ["LONG", "SHORT"]},
    "strategy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "strategy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$"},
    "generated_at_ms": {"type": "integer", "minimum": 946684800000, "maximum": 4102444799999},
    "expires_at_ms": {"type": "integer", "minimum": 946684800000, "maximum": 4102444799999},
    "dry_run": {"type": "boolean"},
    "order": {"$ref": "#/$defs/order"},
    "risk": {"$ref": "#/$defs/risk"},
    "stop": {"$ref": "#/$defs/level"},
    "target": {"$ref": "#/$defs/level"},
    "trail": {"$ref": "#/$defs/trail"},
    "target_ref": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "enter"}}, "required": ["action"]},
      "then": {"required": ["side", "order", "risk", "stop"]}
    },
    {
      "if": {"properties": {"action": {"enum": ["reduce", "close", "modify"]}}, "required": ["action"]},
      "then": {"required": ["target_ref"]}
    }
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 64
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^(0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(\\.[0-9]+)?)$",
      "maxLength": 64
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "value"],
      "properties": {
        "unit": {"enum": ["price", "percent", "ticks", "atr"]},
        "value": {"$ref": "#/$defs/positiveDecimal"}
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "distance"],
      "properties": {
        "method": {"enum": ["fixed", "atr", "recent_high_low"]},
        "distance": {"$ref": "#/$defs/value"},
        "lookback_bars": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000}
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["market", "limit_post_only", "stop_market"]},
        "price": {"anyOf": [{"$ref": "#/$defs/value"}, {"type": "null"}]},
        "expires_at_ms": {"type": ["integer", "null"], "minimum": 946684800000, "maximum": 4102444799999}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_percent": {"$ref": "#/$defs/positiveDecimal"},
        "max_risk_usd": {"$ref": "#/$defs/positiveDecimal"}
      },
      "anyOf": [
        {"required": ["risk_percent"]},
        {"required": ["max_risk_usd"]}
      ]
    },
    "trail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "distance"],
      "properties": {
        "trigger": {"$ref": "#/$defs/value"},
        "distance": {"$ref": "#/$defs/value"},
        "update_step": {"anyOf": [{"$ref": "#/$defs/value"}, {"type": "null"}]}
      }
    }
  }
}
