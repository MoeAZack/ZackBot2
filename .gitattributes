# T04d round 2: byte-exact datasets. DATA_MANIFEST.json pins the SHA-256 of these files' repository (LF) bytes, so every
# checkout - including Git for Windows with core.autocrlf=true - must write them with LF, never CRLF.
# The .bat launchers are deliberately not listed here (they are committed with CRLF and stay as they are).
data/**/*.csv text eol=lf
data1h/**/*.csv text eol=lf
data_long/**/*.csv text eol=lf
DATA_MANIFEST.json text eol=lf
research_evidence/manifests/*.json text eol=lf
research_evidence/universe/*.json text eol=lf
research_evidence/accounting/*.json text eol=lf
research_evidence/manifests/*.json.gz binary
research_evidence/ledger/*.jsonl text eol=lf
# Codex #53 6096066849: the R4 prereg/gate are byte-pinned (no CRLF), so every checkout writes them LF.
research_evidence/prereg/*.json text eol=lf
# All Python is LF in the repo and in every checkout (Codex R1: CRLF pollution from Windows).
*.py text eol=lf
# REX-03: the zb-delist-notice/1 artifacts and their coverage sidecars are byte-pinned by tests (LF only).
research_evidence/notices/*.json text eol=lf
research_evidence/notices/*.md text eol=lf
research_evidence/breadth_prereg/*.json text eol=lf
# exp_structure BTCUSDT derived packet (README, per-trade CSVs, decomposition): LF, byte-stable.
research_evidence/structure_btc_packet/* text eol=lf
