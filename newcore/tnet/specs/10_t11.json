{
  "format": "zb-newcore-tnet-runner/1",
  "id": "T11",
  "name": "restart_open_position",
  "description": "Restart with an open position (in-process: a new Runner on the reopened journal; the subprocess form waits for hook H1): no duplicate entry or stop, protected and reconciled after the restart, then a normal close.",
  "targets": [
    "fake",
    "testnet"
  ],
  "symbol": "SOLUSDT",
  "side": "LONG",
  "sizing": {
    "risk_pct": "0.002",
    "max_leverage": "3"
  },
  "stop": {
    "pct": "1"
  },
  "steps": [
    {
      "op": "enter"
    },
    {
      "op": "restart"
    },
    {
      "op": "tick",
      "n": 1
    },
    {
      "op": "check",
      "what": "protected_reconciled"
    },
    {
      "op": "close"
    },
    {
      "op": "tick",
      "n": 1
    }
  ],
  "expect": {
    "trades": [
      "SIGNAL_EXIT"
    ],
    "max_orders": 3,
    "mode_end": "active",
    "final": "flat"
  },
  "bound": {
    "max_ticks": 10,
    "max_orders": 4,
    "max_notional_usdt": "2000",
    "max_wall_s": 900
  }
